@{
    ViewData["Title"] = "Add New Movie";
}

@model Movie

<form method="POST" class="p-3">
    <input type="hidden" asp-for="MovieId" value="@(Model?.MovieId ?? 0)" />
    
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select class="form-select" asp-for="CategoryId" required>
            <option value="" selected disabled></option>
            @foreach (Category c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Movie Title</label>
        <input class="form-control" asp-for="Title">
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label">Release Year</label>
        <input class="form-control" asp-for="Year">
    </div>

    <div class="mb-3">
        <label asp-for="Director" class="form-label">Director</label>
        <input class="form-control" asp-for="Director" required>
    </div>

    <div class="mb-3">
        <label asp-for="Rating" class="form-label">Rating</label>
        <select class="form-select" asp-for="Rating" required>
            <option value="" selected disabled></option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Edited" class="form-label">Edited</label>
        <select class="form-select" asp-for="Edited">
            <option value="" selected disabled></option>
            <option value="1">Yes</option>
            <option value="0">No</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="LentTo" class="form-label">Lent To</label>
        <input class="form-control" asp-for="LentTo">
    </div>

    <div class="mb-3">
        <label asp-for="Edited" class="form-label">Copied to Plex</label>
        <select class="form-select" asp-for="CopiedToPlex">
            <option value="" selected disabled></option>
            <option value="1">Yes</option>
            <option value="0">No</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes</label>
        <input class="form-control" asp-for="Notes" maxlength="25">
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <button type="submit" class="btn btn-primary">@(Model != null ? "Edit" : "Add") Movie</button>
</form>