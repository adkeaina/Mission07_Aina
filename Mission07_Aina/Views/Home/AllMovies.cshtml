@{
    ViewData["Title"] = "All Movies";
}

@model List<Movie>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Category</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited?</th>
        <th>Lent to</th>
        <th>Copied to Plex?</th>
        <th>Notes</th>
        <th colspan="2" class="text-center">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (Movie m in Model)
    {
        <tr>
            <td>@m.Category?.CategoryName</td>
            <td>@m.Title</td>
            <td>@m.Year</td>
            <td>@m.Director</td>
            <td>@m.Rating</td>
            <td>@(m.Edited == 1 ? "Yes" : "No")</td>
            <td>@m.LentTo</td>
            <td>@(m.CopiedToPlex == 1 ? "Yes" : "No")</td>
            <td>@m.Notes</td>
            <td><a asp-controller="Home" asp-action="Edit" asp-route-id="@m.MovieId" class="btn btn-primary btn-sm">Edit</a></td>
            <td><a asp-controller="Home" asp-action="Delete" asp-route-id="@m.MovieId"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Delete @m.Title?');">
                Delete
            </a></td>
        </tr>
    }
    </tbody>
</table>